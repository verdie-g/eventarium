<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Once dotnet/sdk#55907 ships in the SDK, restore OverrideHtmlAssetPlaceholders=true and
         the webassembly preload, import map, and fingerprinted bootstrap script in index.html. -->
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
    <CompressionEnabled>true</CompressionEnabled>
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Eventarium.Core/Eventarium.Core.csproj" />
  </ItemGroup>

</Project>
